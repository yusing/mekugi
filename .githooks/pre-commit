#!/bin/sh
set -eu

# A rebase replays commits whose trees were already gated; check the result once afterwards.
for state in rebase-merge rebase-apply; do
    if [ -d "$(git rev-parse --git-path "$state")" ]; then
        printf 'Skipping UI snapshot gate during rebase.\n'
        exit 0
    fi
done

docs_changed=0
if git diff --cached --quiet -- '*.md' '*.mdx' '*.rst' '*.adoc' '*.txt' \
    ':(glob,exclude)**/.worktrees/**' ':(glob,exclude)**/node_modules/**' \
    ':(glob,exclude)**/vendor/**' ':(glob,exclude)**/testdata/**' \
    ':(glob,exclude)**/dist/**' ':(glob,exclude)**/build/**'; then
    :
else
    status=$?
    [ "$status" -eq 1 ] || exit "$status"
    docs_changed=1
fi

# Check the exact tree being committed, including partially staged changes.
snapshot_tree=$(mktemp -d /tmp/mekugi-staged-snapshots.XXXXXX)
snapshot_tree=$(cd "$snapshot_tree" && pwd -P)
trap 'rm -rf -- "$snapshot_tree"' 0
trap 'exit 1' HUP INT TERM
mkdir "$snapshot_tree/source" "$snapshot_tree/tmp"
git checkout-index --all --prefix="$snapshot_tree/source/"

# Nested Git test fixtures must not inherit this commit's repository or index.
unset $(git rev-parse --local-env-vars)
cd "$snapshot_tree/source"
if [ "$docs_changed" -eq 1 ]; then
    printf 'Checking documentation in the staged tree...\n'
    if ! env -u BASH_ENV -u MEKUGI_EXEC_TRACK TMPDIR="$snapshot_tree/tmp" make docs-check; then
        printf '%s\n' 'Commit blocked: fix documentation links and heading anchors, then stage the corrections.' >&2
        exit 1
    fi
fi
printf 'Checking all UI snapshots in the staged tree...\n'
if ! env -u BASH_ENV -u MEKUGI_EXEC_TRACK -u MEKUGI_UPDATE_UI_SNAPSHOTS -u COLORFGBG TMPDIR="$snapshot_tree/tmp" \
    make test-ui-snapshots SNAPSHOT_PACKAGES=@snapshots SNAPSHOT='^TestUISnapshot'; then
    printf '%s\n' 'Commit blocked: review the snapshot diff and stage current baselines.' >&2
    exit 1
fi
