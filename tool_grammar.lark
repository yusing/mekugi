start: _blank_line* script _blank_line*

script: resume_command | command (_separator command)*

resume_command: "resume" SP RESUME_HANDLE (SP RESUME_ACTION)? (_separator command (_separator command)*)?
RESUME_HANDLE: /[a-z]+[0-9]*/
RESUME_ACTION: "retry" | "accept" | "repair"

?command: path_command
        | "rm"
        | inline_mutation
        | heredoc_mutation
        | inline_initializer
        | shell_command
        | heredoc_initializer

shell_command: "shell" SP (heredoc | SHELL_INLINE)
// Single-line source cannot contain <<, even in quotes. Use a heredoc instead.
SHELL_INLINE: /(?:(?:[^<\n]|<[^<\n])+<?|<)/

path_command: PATH_OP SP PATH
inline_mutation: "type" SP target SP QUOTED
               | "add" SP add_destination SP QUOTED
heredoc_mutation: "type" SP target SP heredoc
                | "add" SP add_destination SP heredoc
inline_initializer: "type" SP QUOTED
heredoc_initializer: "type" SP heredoc

// Keep free-form body and candidate closing lines in one lexer terminal.
// Separate body/end terminals greedily swallow a closing line with its newline,
// forbidding end-of-call. The shared parser validates exact framing before effects.
heredoc: HEREDOC_MARKER NL HEREDOC_CONTENT
HEREDOC_MARKER: /<<-?[ \t]*(?:[^\s'"\\<>|;&()]+|\\[^\r\n]|'[^'\r\n]*'|"(?:\\[^\r\n]|[^"\\\r\n])*")+[ \t]*/
HEREDOC_CONTENT: /(?:[^\n]*\n)*[^\r\n]+(?:\r?\n)*/

?target: ROW
       | ROW ".." ROW
       | ROW SP TARGET_QUOTED (SP POSINT)?
       | TARGET_QUOTED (SP POSINT)?

?add_destination: ROW
                | ROW SP TARGET_QUOTED (SP POSINT)?
                | TARGET_QUOTED (SP POSINT)?
                | "EOF"

_separator: NL _blank_line*
_blank_line: HSPACE? NL

PATH_OP: "in" | "new" | "mv"
ROW: /[1-9][0-9]*:[0-9a-f]{4}/
POSINT: /[1-9][0-9]*/

SP: " "
HSPACE: /[ \t]+/
PATH: /[^\r\n]+/
NL: /\r?\n/
QUOTED: /"(?:\\(?:["\\\/bfnrt]|u[0-9A-Fa-f]{4})|[^\x00-\x1F"\\]|\t)*"/
TARGET_QUOTED: /"(?:\\(?:["\\\/nt]|u(?:000[9Aa]|00[2-9A-Fa-f][0-9A-Fa-f]|0[1-9A-Fa-f][0-9A-Fa-f]{2}|[1-9A-Fa-f][0-9A-Fa-f]{3}))|[^\x00-\x1F"\\]|\t)+"/
