# Absolute parent directory of the execution machine's control.sock (0700).
MEKUGI_SERVER_DIR=/absolute/path/to/private/mekugi/server
# Match the execution server's host user: id -u and id -g.
MEKUGI_UID=1000
MEKUGI_GID=1000
# Create this private directory before startup: install -d -m 700 .docker/connector
CONNECTOR_STATE_DIR=./.docker/connector
# Docker host's Tailscale IPv4 address: tailscale ip -4
TAILNET_IP=100.64.0.1
WEBUI_PORT=7777
CONNECTOR_PORT=7778
# Exact browser page origin, including a non-default port. Use HTTPS behind TLS.
WEBUI_ORIGIN=http://100.64.0.1:7777
